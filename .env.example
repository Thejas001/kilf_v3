# Copy to .env.local for local development; set the same variables in Vercel/Netlify.

# Public site URL (canonical links, sitemap, OG tags, QR code)
SITE_URL=https://kilf.vercel.app

# Form endpoint (Formspree, Getform, or a Google Apps Script web-app URL).
# All forms POST JSON here with a "form" field naming the form.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional per-form overrides (fall back to NEXT_PUBLIC_FORM_ENDPOINT)
NEXT_PUBLIC_FORM_ENDPOINT_PARTNER=
NEXT_PUBLIC_FORM_ENDPOINT_NEWSLETTER=

# Analytics: set ONE of these (leave both empty to disable)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: link for the "Book a partnership call" button (Calendly, Cal.com…)
NEXT_PUBLIC_PARTNER_CALL_URL=
# Optional: WhatsApp channel/community invite link for the signup block
NEXT_PUBLIC_WHATSAPP_URL=

# Backend API origin (no trailing slash, no /api suffix: the code adds /api/...).
# e.g. early-bird form -> POST {url}/api/early-bird, passes -> GET {url}/api/tickets;
# if unset or unreachable, the passes page falls back to content/passes.json.
NEXT_PUBLIC_API_URL=https://api.kilf.in
